# LazyStudy AI Configuration
# Port for backend server
PORT=5001

# URL where your local Ollama instance is running (default: http://127.0.0.1:11434)
OLLAMA_HOST=http://127.0.0.1:11434

# Open-weight model name installed in Ollama
# Recommended options:
# - qwen2.5:3b     (Best balance of speed and reasoning, ~1.9GB)
# - qwen2.5:1.5b   (Fastest, lowest memory, ~1.0GB)
# - gemma2:2b      (High quality writing, ~1.6GB)
# - llama3.2:3b    (Meta open-weight model, ~2.0GB)
OLLAMA_MODEL=qwen2.5:3b

# Set to 'production' when serving static client build
NODE_ENV=development
